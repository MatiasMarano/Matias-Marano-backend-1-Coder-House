<h1>Carrito</h1>
<ul>
  {{#each cart.products}}
    <li>
      <h3>{{this.product.title}}</h3>
      <p>Precio unitario: ${{this.product.price}}</p>
      <p>Cantidad: {{this.quantity}}</p>
      <p>Total: ${{multiply this.product.price this.quantity}}</p>

      <form action="/carts/{{../cart._id}}/products/{{this.product._id}}?_method=PUT" method="post">
        <input type="number" name="quantity" value="{{this.quantity}}" min="1">
        <button type="submit">Actualizar cantidad</button>
      </form>

      <form action="/carts/{{../cart._id}}/products/{{this.product._id}}?_method=DELETE" method="post">
        <button type="submit">Eliminar producto</button>
      </form>
    </li>
  {{/each}}
</ul>

<form action="/carts/{{cart._id}}?_method=DELETE" method="post">
  <button type="submit">Vaciar carrito</button>
</form>
