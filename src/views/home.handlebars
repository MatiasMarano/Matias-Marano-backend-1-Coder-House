<h1>{{title}}</h1>

{{#if products.length}}
  <ul>
    {{#each products}}
      <li>
        <strong>{{this.title}}</strong> - ${{this.price}}
        <br>
        {{this.description}}
        <br>
        <em>Categoría: {{this.category}}</em>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p>No hay productos cargados.</p>
{{/if}}

<a href="/realtimeproducts">Ir a productos en tiempo real</a>
