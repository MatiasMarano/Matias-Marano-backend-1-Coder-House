<h1>Productos</h1>

<ul>
  {{#each products}}
  <li>
    <h3>{{this.title}}</h3>
    <p>Precio: ${{this.price}}</p>
    <p>Categoría: {{this.category}}</p>
    <p>Stock: {{this.stock}}</p>

    <form action="/api/carts/{{../cartId}}/product/{{this._id}}" method="post">
      <button type="submit">Agregar al carrito</button>
    </form>

    <a href="/products/{{this._id}}">Ver detalles</a>
  </li>
  {{/each}}
</ul>

<div>
  {{#if hasPrevPage}}
    <a href="?page={{prevPage}}&limit={{limit}}{{#if sort}}&sort={{sort}}{{/if}}{{#if query}}&query={{query}}{{/if}}">Anterior</a>
  {{/if}}
  <span>Página {{page}} de {{totalPages}}</span>
  {{#if hasNextPage}}
    <a href="?page={{nextPage}}&limit={{limit}}{{#if sort}}&sort={{sort}}{{/if}}{{#if query}}&query={{query}}{{/if}}">Siguiente</a>
  {{/if}}
</div>
