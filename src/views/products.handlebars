<h1>Productos</h1>
<div class="grid">
  {{#each products}}
    <div class="card">
      <h3>{{this.title}}</h3>
      <p>Precio: ${{this.price}}</p>

      <!-- Botón para agregar directo al carrito -->
      <form action="/carts/{{../cartId}}/products/{{this._id}}" method="post">
        <button type="submit">Agregar al carrito</button>
      </form>

      <!-- Link para ver detalle -->
      <a href="/products/{{this._id}}">Ver detalle</a>
    </div>
  {{/each}}
</div>

<div class="pagination">
  {{#if hasPrevPage}}
    <a href="/products?page={{prevPage}}&limit={{limit}}">Anterior</a>
  {{/if}}
  <span>Página {{page}} de {{totalPages}}</span>
  {{#if hasNextPage}}
    <a href="/products?page={{nextPage}}&limit={{limit}}">Siguiente</a>
  {{/if}}
</div>
